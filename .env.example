# ==============================================================================
# TEMPLATE KONFIGURASI GLOBAL SISTEM SKORING MENEMBAK
# Salin file ini menjadi .env lokal dan sesuaikan isinya.
# JANGAN SIMPAN KREDENSIAL ASLI DI DALAM FILE INI.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. KONFIGURASI WEB APPLICATION (PHP LARAVEL)
# ------------------------------------------------------------------------------
APP_NAME="Sistem Skoring Menembak"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 2. BASIS DATA LOKAL (MYSQL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_skoring_menembak
DB_USERNAME=root
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 3. AI ENGINE SERVICE (PYTHON FASTAPI + YOLOV8)
# ------------------------------------------------------------------------------
AI_ENGINE_HOST=127.0.0.1
AI_ENGINE_PORT=8001
AI_ENGINE_URL=http://127.0.0.1:8001/api/v1/detect
YOLO_MODEL_PATH=models/best_lesan_yolov8.pt
CONFIDENCE_THRESHOLD=0.50

# ------------------------------------------------------------------------------
# 4. PENYIMPANAN BERKAS (FILE STORAGE)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
TARGET_IMAGE_UPLOAD_PATH=storage/app/public/targets