# Only src/django-app/.env is loaded. Existing environment variables take precedence.
# manage.py defaults to development; WSGI/ASGI defaults to production.
# Select settings through the process environment or manage.py --settings, never here.
DJANGO_SECRET_KEY=django-insecure-development-only-replace-before-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_LOG_LEVEL=INFO

# Provision a NEW PostgreSQL database and dedicated user before using DB commands.
# These are example values, not working credentials. Never point at the legacy DB.
POSTGRES_DB=ta_skoring_django
POSTGRES_USER=ta_skoring_app
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
